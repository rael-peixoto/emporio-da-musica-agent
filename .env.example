# Copy this file to .env and fill in ONE of the options. Never commit .env.

# Option A (default): hosted proxy, no API key needed.
# Paste the access code that was sent with the submission.
EMPORIO_ACCESS_CODE=

# Option B: your own Anthropic API key (direct mode). When set, the proxy is not used.
ANTHROPIC_API_KEY=

# Optional overrides
# LLM_BACKEND=proxy          # force a mode: proxy | direct
# PROXY_URL=https://...      # use another proxy deployment
# MODEL=claude-haiku-5-5     # direct mode only; the proxy enforces its own model
# EFFORT=low                 # low | medium | high | xhigh | max
